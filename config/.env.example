# Copiez ces variables dans la configuration Apache/XAMPP ou dans les variables système Windows.
EVENTSECURE_DB_HOST=127.0.0.1
EVENTSECURE_DB_NAME=gestion_evenements
EVENTSECURE_DB_USER=eventsecure_app
EVENTSECURE_DB_PASSWORD=changez_ce_mot_de_passe
# Facultatif : chemin privé hors du répertoire web pour les billets PDF.
EVENTSECURE_PRIVATE_STORAGE=C:\xampp\eventsecure-storage

# IAM / OpenID Connect (Keycloak)
EVENTSECURE_IAM_ENABLED=false
EVENTSECURE_LOCAL_LOGIN_ENABLED=true
EVENTSECURE_BASE_URL=http://localhost/gestion_evenements
EVENTSECURE_OIDC_ISSUER=http://localhost:8081/realms/eventsecure
EVENTSECURE_OIDC_CLIENT_ID=eventsecure-web
EVENTSECURE_OIDC_REDIRECT_URI=http://localhost/gestion_evenements/auth/keycloak.php
EVENTSECURE_OIDC_POST_LOGOUT_URI=http://localhost/gestion_evenements/
# Laisser vide pour le client public PKCE fourni. En production, préférer un client confidentiel.
EVENTSECURE_OIDC_CLIENT_SECRET=
